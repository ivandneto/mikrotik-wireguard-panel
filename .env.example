# ===== MikroTik connection =====
# http://IP  -> RouterOS "www" service (simpler, only use it inside your network)
# https://IP -> "www-ssl" service (recommended; see mikrotik-setup.rsc)
MIKROTIK_URL=https://192.168.88.1
MIKROTIK_USER=wgpanel
MIKROTIK_PASSWORD=change-this-password
# Self-signed certificate on the MikroTik? leave false
MIKROTIK_VERIFY_TLS=false

# ===== Panel =====
# Administrator user created on the first start (manage users in the panel afterwards)
ADMIN_USER=admin
# If left empty, a random password is generated and shown in the log (docker compose logs)
ADMIN_PASSWORD=

# Monitoring collection interval (seconds, minimum 10)
POLL_INTERVAL=30

# Login session length (hours)
SESSION_HOURS=12

# Key used to encrypt the VPN keys in the database.
# If empty, it is generated automatically in data/secret.key — do NOT lose that file.
SECRET_KEY=

# true if the panel is accessed over HTTPS (behind a reverse proxy)
COOKIE_SECURE=false
