# ===== Conexão com o MikroTik =====
# http://IP  -> serviço "www" do RouterOS (mais simples, só use dentro da sua rede)
# https://IP -> serviço "www-ssl" (recomendado; veja mikrotik-setup.rsc)
MIKROTIK_URL=https://192.168.88.1
MIKROTIK_USER=wgpanel
MIKROTIK_PASSWORD=troque-esta-senha
# Certificado autoassinado no MikroTik? deixe false
MIKROTIK_VERIFY_TLS=false

# ===== Painel =====
# Usuário administrador criado no primeiro start (depois gerencie pelo painel)
ADMIN_USER=admin
# Se ficar vazio, uma senha aleatória é gerada e mostrada no log (docker compose logs)
ADMIN_PASSWORD=

# Intervalo de coleta do monitoramento (segundos, mínimo 10)
POLL_INTERVAL=30

# Duração da sessão de login (horas)
SESSION_HOURS=12

# Chave usada para criptografar as chaves da VPN no banco.
# Se vazia, é gerada automaticamente em data/secret.key — NÃO perca esse arquivo.
SECRET_KEY=

# true se o painel for acessado por HTTPS (atrás de proxy reverso)
COOKIE_SECURE=false
